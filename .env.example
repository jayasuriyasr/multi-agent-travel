# Axentra configuration.
#
# Every variable here is read by internal/config and reaches the running
# system. Copy to .env and adjust; unset variables fall back to the defaults
# shown after each name.

# ── Postgres ─────────────────────────────────────────────────────────────────
PG_DSN=postgres://axentra_user:axentra_pass@localhost:5432/axentra_db?sslmode=disable
PG_MAX_CONNS=10

# Apply pending migrations automatically at startup. Safe to leave on: the
# runner is idempotent and records what it has applied.
AUTO_MIGRATE=true
MIGRATIONS_DIR=./migrations

# ── Redis ────────────────────────────────────────────────────────────────────
# REDIS_ADDR, REDIS_PASSWORD and REDIS_DB are derived from REDIS_URL when unset.
REDIS_URL=redis://localhost:6379/0
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ── HTTP ─────────────────────────────────────────────────────────────────────
FIBER_PORT=8080
HTTP_READ_TIMEOUT_SEC=15
# Per-request budget for search + seat validation.
REQUEST_TIMEOUT_SEC=10
BODY_LIMIT_BYTES=1048576
# Requests per minute per client IP. 0 disables the limiter.
RATE_LIMIT_PER_MIN=600
CORS_ORIGINS=*
WEB_ROOT=./web

# ── Redis batching ───────────────────────────────────────────────────────────
# These interact with cluster limits and latency budgets, so tuning them must
# not require a recompile.
# Keys per MGET, for seat validation and seat snapshots.
REDIS_MGET_CHUNK=512
# Entries consumed per dirty-stream XREAD.
STREAM_BATCH_SIZE=500
# Floor between full re-synchronisations after stream lag. A cold start reads
# every known trip, and lag is what a struggling Redis produces — without a
# floor, the answer to "Redis is unhealthy" becomes "read everything from
# Redis", repeatedly.
MIN_RESYNC_INTERVAL_SEC=30

# ── Seat-validation circuit breaker ──────────────────────────────────────────
# Consecutive failed validations before calls stop being sent to Redis at all.
SEAT_BREAKER_THRESHOLD=5
# How long the breaker stays open before letting one probe through.
SEAT_BREAKER_COOLDOWN_SEC=15

# ── Footpath closure ─────────────────────────────────────────────────────────
# How far the transitive walk closure will go.
MAX_WALK_SECONDS=1800
# Cap on closed walk edges per station, nearest first. These edges are re-walked
# on every footpath relaxation of every round of every search, so an unbounded
# closure over a dense interchange district taxes each query, not just the load.
MAX_FOOTPATHS_PER_STATION=64

# ── Background workers ───────────────────────────────────────────────────────
ASYNQ_CONCURRENCY=20
# How often to re-check schema_version. Postgres NOTIFY handles the fast path;
# this is the safety net if the notification channel goes quiet.
WATCHER_INTERVAL_SEC=30
# How often to re-classify trips into polling zones.
CLASSIFY_INTERVAL_SEC=300

# ── Seat provider ────────────────────────────────────────────────────────────
# "mock" generates plausible availability so the system runs end to end with no
# third-party credentials. "http" calls a real API and requires SEAT_API_BASE_URL.
SEAT_PROVIDER=mock
# SEAT_API_BASE_URL=https://seats.example.com/availability
# SEAT_API_KEY=
SEAT_API_TIMEOUT_SEC=5

# ── Search tuning ────────────────────────────────────────────────────────────
# Round limit: k rounds allows journeys with up to k vehicles (k-1 transfers).
MAX_ROUNDS=4
# Minimum time to change vehicles. 0 is pure timetable semantics; raise it once
# you have real station geometry.
MIN_TRANSFER_SECONDS=0
# How many calendar days after the search date trips may be used from. The day
# before is always included, for overnight services already in motion.
DATE_WINDOW_DAYS=2
SEARCH_CANDIDATES=9
SEARCH_RESULTS=5

# Seat validation on Redis failure.
#   false — return unvalidated results (read-only search stays available)
#   true  — reject everything (correct for booking, prevents overselling)
STRICT_SEAT_MODE=false

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
# text | json
LOG_FORMAT=text
